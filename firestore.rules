rules_version = '2';

// Lamba data is private by default. Every personal document lives under
// users/{uid}/... and only that signed-in owner can read or write it.
// The one exception is publicRecipes: recipes an owner chose to share.
// Any signed-in user may read them, but only the author (matched by the
// authorUid field) may create, update or delete their own. Everything
// else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /publicRecipes/{recipeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;
    }

    // The shared daily recipe, one document per day (dailyRecipes/{date}).
    // Every signed-in user reads the same recipe. Clients never write
    // here: only the deploy service account writes it, and the Admin SDK
    // bypasses these rules.
    match /dailyRecipes/{date} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // App config (config/app): written by the deploy sync script only.
    // Any signed-in user may read it (the client needs ownerUid to decide
    // who sees the Export button); clients never write it.
    match /config/app {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
